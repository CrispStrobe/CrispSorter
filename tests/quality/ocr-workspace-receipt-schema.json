{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CrispStrobe/CrispSorter/blob/main/tests/quality/ocr-workspace-receipt-schema.json",
  "title": "CrispSorter OCR workspace qualification receipt",
  "description": "Scoped evidence, never one aggregate pass. Synthetic interactions, parsing, live provider execution, real corpus quality, installed devices, and standards remain separate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "recorded_at",
    "scope",
    "app",
    "environment",
    "engine",
    "models",
    "settings",
    "inputs",
    "checks",
    "limitations"
  ],
  "properties": {
    "schema": {"const": "crispsorter-ocr-workspace-receipt-v1"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "scope": {"type": "string", "minLength": 1},
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_commit", "version", "dirty"],
      "properties": {
        "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "version": {"type": ["string", "null"]},
        "dirty": {"type": "boolean"},
        "binary": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch", "device", "runtime"],
      "properties": {
        "os": {"type": "string", "minLength": 1},
        "arch": {"type": "string", "minLength": 1},
        "device": {"type": ["string", "null"]},
        "runtime": {"type": ["string", "null"]},
        "toolchains": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "engine": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "installed_languages"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "source_commit": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40}$"},
            "binary": {"$ref": "#/$defs/artifact"},
            "installed_languages": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          }
        }
      ]
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "artifact"],
        "properties": {"name": {"type": "string", "minLength": 1}, "artifact": {"$ref": "#/$defs/artifact"}}
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "effective"],
      "properties": {"requested": {"type": "object"}, "effective": {"type": "object"}}
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "asset", "ground_truth", "width", "height"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["synthetic_fixture", "recorded_provider_output", "real_scan", "other"]},
          "asset": {"$ref": "#/$defs/artifact"},
          "ground_truth": {"anyOf": [{"$ref": "#/$defs/artifact"}, {"type": "null"}]},
          "width": {"type": ["integer", "null"], "minimum": 1},
          "height": {"type": ["integer", "null"], "minimum": 1},
          "tags": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["synthetic_ui", "native_parser", "native_provider", "live_corpus", "device", "standards"],
      "properties": {
        "synthetic_ui": {
          "allOf": [
            {"$ref": "#/$defs/gate"},
            {"properties": {"execution_boundary": {"enum": ["none", "production_component_fixture"]}}}
          ]
        },
        "native_parser": {
          "allOf": [
            {"$ref": "#/$defs/gate"},
            {
              "properties": {
                "execution_boundary": {"enum": ["none", "recorded_parser", "production_module", "installed_app"]}
              }
            }
          ]
        },
        "native_provider": {
          "allOf": [
            {"$ref": "#/$defs/gate"},
            {
              "properties": {"execution_boundary": {"enum": ["none", "external_cli", "production_module", "installed_app"]}}
            }
          ]
        },
        "live_corpus": {
          "allOf": [
            {"$ref": "#/$defs/gate"},
            {
              "properties": {"execution_boundary": {"enum": ["none", "external_cli", "production_module", "installed_app"]}}
            }
          ]
        },
        "device": {
          "allOf": [
            {"$ref": "#/$defs/gate"},
            {"properties": {"execution_boundary": {"enum": ["none", "installed_app"]}}}
          ]
        },
        "standards": {
          "allOf": [
            {"$ref": "#/$defs/gate"},
            {"properties": {"execution_boundary": {"enum": ["none", "independent_validator"]}}}
          ]
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "command", "elapsed_ms", "input_ids", "assertions", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"enum": ["passed", "failed", "blocked", "not_run", "not_applicable"]},
        "command": {"type": "array", "items": {"type": "string"}},
        "elapsed_ms": {"type": ["number", "null"], "minimum": 0},
        "input_ids": {"type": "array", "items": {"type": "string"}},
        "assertions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
        "metrics": {"type": "object", "additionalProperties": {"type": "number"}},
        "settings": {"type": "object"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "passed"}}},
          "then": {
            "properties": {
              "elapsed_ms": {"type": "number", "minimum": 0},
              "assertions": {"minItems": 1},
              "evidence": {"minItems": 1}
            }
          }
        }
      ]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "execution_boundary", "summary", "results"],
      "properties": {
        "status": {"enum": ["passed", "failed", "blocked", "not_run", "not_applicable"]},
        "execution_boundary": {
          "enum": [
            "none",
            "production_component_fixture",
            "recorded_parser",
            "external_cli",
            "production_module",
            "installed_app",
            "independent_validator"
          ]
        },
        "summary": {"type": "string", "minLength": 1},
        "results": {"type": "array", "items": {"$ref": "#/$defs/result"}}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "passed"}}},
          "then": {
            "properties": {
              "execution_boundary": {"not": {"const": "none"}},
              "results": {
                "minItems": 1,
                "items": {"allOf": [{"$ref": "#/$defs/result"}, {"properties": {"status": {"const": "passed"}}}]}
              }
            }
          }
        }
      ]
    }
  }
}
