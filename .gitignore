# Node.js
node_modules
/build
/.svelte-kit
/package
.env
.env.*
!.env.example
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Tauri / Rust
# Workspace target dir lives at the repo root since the integration of
# crisp-index-server (May 2026). The legacy `src-tauri/target` glob is
# kept for branches that still build pre-workspace.
/target
src-tauri/target
src-tauri/gen
src-tauri/bin

# crisp-index-server runtime data (LanceDB + Tantivy index) — never commit;
# can grow to terabytes on a real deployment.
crisp-index-server/data
crisp-index-server/target

# Bootstrapped tools (paths.ps1 downloads protoc here)
gh_temp/

# OS
.DS_Store
Thumbs.db

# Samples (to keep the repo lean)
samples/

# Session-handover prompts.  Local-only by convention — they reference
# absolute paths (~/.claude memory dirs, sibling repos at
# ../CrispLens, etc.) that don't make sense to ship in the repo, and
# often quote credentials by env-var name in test recipes.
# Tracked references in PLAN.md / HISTORY.md cite the local path
# (handover-prompts/...) but the content lives outside git.
handover-prompts/
