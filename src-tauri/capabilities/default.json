{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "http:default",
    "dialog:default",
    "store:default",
    "fs:default",
    "fs:read-all",
    "fs:write-all",
    {
      "identifier": "http:allow-fetch",
      "allow": [{ "url": "**" }]
    },
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$HOME/**" }, { "path": "/" }, { "path": "/**" }]
    }
  ]
}
