{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Capability for the mobile app — no shell/process, scoped filesystem",
  "windows": ["main"],
  "platforms": ["iOS", "android"],
  "permissions": [
    "core:default",
    "opener:default",
    "http:default",
    "dialog:default",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "store:default",
    "fs:default",
    "fs:read-all",
    "fs:write-all",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        { "url": "http://*" },
        { "url": "https://*" },
        { "url": "http://localhost:*" },
        { "url": "http://127.0.0.1:*" }
      ]
    },
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$APPDATA/**" }, { "path": "$DOWNLOAD/**" }]
    }
  ]
}
