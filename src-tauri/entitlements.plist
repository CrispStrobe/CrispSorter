<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Sandbox (mandatory for Mac App Store) -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Network: cloud sync, LLM API calls, cloud drive connectors -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Local server: Tauri's localhost dev server, crisp-index-server -->
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- User-selected files: document import/export via file picker -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Downloads folder: batch export, translated DOCX output -->
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>

    <!-- Persist a folder the user picked, so sorting into it survives a
         restart. Without this, `files.user-selected.read-write` grants
         access only until the process exits, and every sort into the same
         destination needs a fresh pick. Note the failure mode it removes:
         `bookmarkDataWithOptions:` refuses at *creation* time when this key
         is absent, which reads as though the folder were at fault. -->
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>

    <!-- App Store / TestFlight identity: must match the embedded provisioning
         profile's app id, or altool warns (90886) "not TestFlight-eligible". -->
    <key>com.apple.application-identifier</key>
    <string>N9XSJ4M3GT.com.crispstrobe.crispsorter</string>
    <key>com.apple.developer.team-identifier</key>
    <string>N9XSJ4M3GT</string>
</dict>
</plist>
