{
  "schema": "crispsorter-ocr-bench-engines-v1",
  "notes": [
    "id is the benchmark's name for one engine configuration; engine is the value passed to `crispsorter ocr --engine`.",
    "devices: where the configuration is benchmarked. Engines that never touch ggml (system_tesseract, ocrs, paddle) are CPU-only: a Kaggle GPU session must not be spent on them.",
    "group + cpu_shards drive the GitHub Actions CPU matrix (runner.py plan): engines sharing a group with cpu_shards 1 run in one job; an engine with cpu_shards n gets n jobs that split its pages.",
    "timeout_s is the per-page wall-clock limit per device. license_gated engines need --accept-license (always passed; recorded in every unit).",
    "language 'page' passes the page's language (eng/deu/fra from its tags) as --language, as a user who picked the document language would; null passes none.",
    "default false = not part of `--engines default`; select explicitly by id."
  ],
  "engines": [
    {"id": "auto", "engine": "auto", "devices": ["cpu", "gpu"], "group": "classic", "cpu_shards": 1, "timeout_s": {"cpu": 600, "gpu": 600}, "language": "page", "default": true},
    {"id": "system_tesseract", "engine": "system_tesseract", "devices": ["cpu"], "group": "classic", "cpu_shards": 1, "timeout_s": {"cpu": 300}, "language": "page", "default": true,
     "notes": "Needs the tesseract executable plus eng/deu/fra (and frk) traineddata on the host."},
    {"id": "ocrs", "engine": "ocrs", "devices": ["cpu"], "group": "classic", "cpu_shards": 1, "timeout_s": {"cpu": 300}, "language": null, "default": true},
    {"id": "paddle", "engine": "paddle", "devices": ["cpu"], "group": "classic", "cpu_shards": 1, "timeout_s": {"cpu": 300}, "language": null, "default": true,
     "notes": "Requires a build with the paddle-ocr cargo feature; otherwise every unit records status unsupported."},
    {"id": "tesseract", "engine": "tesseract", "devices": ["cpu", "gpu"], "group": "classic", "cpu_shards": 1, "timeout_s": {"cpu": 600, "gpu": 600}, "language": "page", "default": true},
    {"id": "tesseract_fraktur", "engine": "tesseract_fraktur", "devices": ["cpu", "gpu"], "group": "classic", "cpu_shards": 1, "timeout_s": {"cpu": 600, "gpu": 600}, "language": null, "default": true},
    {"id": "dbnet_trocr", "engine": "dbnet_trocr", "devices": ["cpu", "gpu"], "group": "detrec", "cpu_shards": 1, "timeout_s": {"cpu": 900, "gpu": 600}, "language": null, "default": true},
    {"id": "surya", "engine": "surya", "args": ["--det-model", "surya-det", "--rec-model", "trocr-printed"], "devices": ["cpu", "gpu"], "group": "detrec", "cpu_shards": 1, "timeout_s": {"cpu": 900, "gpu": 600}, "language": null, "license_gated": true, "default": true,
     "notes": "The surya stage requires explicit det/rec models; surya-det is OpenRAIL-M (consent-gated)."},
    {"id": "parseq", "engine": "parseq", "devices": ["cpu", "gpu"], "group": "detrec", "cpu_shards": 1, "timeout_s": {"cpu": 900, "gpu": 600}, "language": null, "default": true},
    {"id": "ppocrv6", "engine": "ppocrv6", "devices": ["cpu", "gpu"], "group": "detrec", "cpu_shards": 1, "timeout_s": {"cpu": 900, "gpu": 600}, "language": null, "default": true},
    {"id": "easyocr", "engine": "easyocr", "devices": ["cpu", "gpu"], "group": "detrec", "cpu_shards": 1, "timeout_s": {"cpu": 900, "gpu": 600}, "language": null, "default": true},
    {"id": "glm", "engine": "glm", "devices": ["cpu", "gpu"], "group": "glm", "cpu_shards": 3, "timeout_s": {"cpu": 1800, "gpu": 900}, "language": "page", "default": true},
    {"id": "got", "engine": "got", "devices": ["cpu", "gpu"], "group": "got", "cpu_shards": 2, "timeout_s": {"cpu": 1800, "gpu": 900}, "language": "page", "license_gated": true, "default": true,
     "notes": "Tongyi Qianwen research licence (non-commercial); internal evaluation only."},
    {"id": "qwen2vl", "engine": "qwen2vl", "devices": ["cpu", "gpu"], "group": "qwen2vl", "cpu_shards": 3, "timeout_s": {"cpu": 2400, "gpu": 900}, "language": "page", "license_gated": true, "default": true},
    {"id": "qwen2vl_cpubudget", "engine": "qwen2vl", "args": ["--cpu-pixel-budget"], "devices": ["cpu"], "group": "qwen2vl_cpubudget", "cpu_shards": 3, "timeout_s": {"cpu": 2400}, "language": "page", "license_gated": true, "default": true,
     "notes": "The isolated low-memory Qwen2-VL CPU worker (child process): peak RSS must include children."},
    {"id": "qwen3vl", "engine": "qwen3vl", "devices": ["cpu", "gpu"], "group": "qwen3vl", "cpu_shards": 3, "timeout_s": {"cpu": 2400, "gpu": 900}, "language": "page", "default": true},
    {"id": "internvl2", "engine": "internvl2", "devices": ["cpu", "gpu"], "group": "internvl2", "cpu_shards": 3, "timeout_s": {"cpu": 2400, "gpu": 900}, "language": "page", "default": true},
    {"id": "deepseek_ocr2", "engine": "deepseek_ocr2", "devices": ["cpu", "gpu"], "group": "deepseek_ocr2", "cpu_shards": 3, "timeout_s": {"cpu": 2400, "gpu": 900}, "language": "page", "default": true},
    {"id": "pix2struct", "engine": "pix2struct", "devices": ["cpu", "gpu"], "group": "pix2struct", "cpu_shards": 2, "timeout_s": {"cpu": 1800, "gpu": 900}, "language": "page", "default": true},
    {"id": "granite_vision", "engine": "granite_vision", "devices": ["cpu", "gpu"], "group": "granite_vision", "cpu_shards": 3, "timeout_s": {"cpu": 2400, "gpu": 900}, "language": "page", "default": true},
    {"id": "lightonocr", "engine": "lightonocr", "devices": ["cpu", "gpu"], "group": "lightonocr", "cpu_shards": 3, "timeout_s": {"cpu": 2400, "gpu": 900}, "language": "page", "default": true},
    {"id": "unlimited_ocr", "engine": "unlimited_ocr", "devices": ["cpu", "gpu"], "group": "unlimited_ocr", "cpu_shards": 3, "timeout_s": {"cpu": 2400, "gpu": 900}, "language": "page", "default": true},
    {"id": "olmocr", "engine": "olmocr", "devices": ["cpu", "gpu"], "group": "olmocr", "cpu_shards": 4, "timeout_s": {"cpu": 3000, "gpu": 1200}, "language": "page", "default": true,
     "notes": "7B: expect CPU OOM/timeouts on a 16 GB runner; those are recorded, not hidden."},
    {"id": "lfm2_vl", "engine": "lfm2_vl", "devices": ["cpu", "gpu"], "group": "lfm2_vl", "cpu_shards": 2, "timeout_s": {"cpu": 1800, "gpu": 900}, "language": "page", "default": true},
    {"id": "unlimited_ocr2", "engine": "unlimited_ocr2", "env": {"CRISPEMBED_UNLIMITED_OCR2": "1"}, "devices": ["cpu", "gpu"], "group": "unlimited_ocr2", "cpu_shards": 3, "timeout_s": {"cpu": 2400, "gpu": 900}, "language": "page", "default": false,
     "notes": "Experimental; runtime-gated by CRISPEMBED_UNLIMITED_OCR2=1."},
    {"id": "minicpm_ocr", "engine": "minicpm_ocr", "env": {"CRISPEMBED_MINICPM_OCR": "1", "CRISPEMBED_QWEN35_OCR": "1"}, "devices": ["cpu", "gpu"], "group": "minicpm_ocr", "cpu_shards": 3, "timeout_s": {"cpu": 2400, "gpu": 900}, "language": "page", "default": false,
     "notes": "Experimental; runtime-gated by CRISPEMBED_MINICPM_OCR=1 and CRISPEMBED_QWEN35_OCR=1."}
  ]
}
